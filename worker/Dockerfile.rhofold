# RhoFold+ Runpod Serverless worker image.
#
# Predicts a 3D RNA structure (PDB + per-residue pLDDT) in SINGLE-SEQUENCE mode —
# no MSA generation at runtime, so no network/databases and job isolation holds.
# worker/run_rhofold.py invokes the upstream inference.py baked in here, pointed at
# the pre-baked checkpoint (RHOFOLD_CHECKPOINT); without the checkpoint the runner
# falls back to a clearly-marked stub (CPU/CI only).
#
# NOT the repo-root Dockerfile (that one is structRFM's — Runpod only auto-detects a
# single root Dockerfile). Build THIS one via GitHub Actions and deploy from GHCR
# with Runpod's "Docker Image" flow — see docs/RHOFOLD_DEPLOY.md.
#
# Upstream: https://github.com/ml4bio/RhoFold  (Apache-2.0)
# Checkpoint: rhofold_pretrained_params.pt  (huggingface.co/cuhkaih/rhofold)
#
# Build (GPU hosts are linux/amd64):
#   docker build --platform linux/amd64 -f worker/Dockerfile.rhofold \
#     --build-arg RHOFOLD_COMMIT=<full-sha> \
#     --build-arg RHOFOLD_CKPT_SHA256=<sha256> \
#     -t <registry>/rhofold-worker:<tag> .

# See requirements-rhofold.txt: upstream's torch 1.10 lacks modern-GPU kernels, so
# we use the same 2.7.1 / CUDA 12.8 base structRFM moved to (covers sm_50..sm_120).
# ⚠ torch-2.7 API-compat with RhoFold is unverified — confirm on the first smoke run.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

# TODO: replace with a pinned upstream commit + verified checkpoint sha256 so the
# image is reproducible (CLAUDE.md "pinned-and-checksummed weights").
ARG RHOFOLD_COMMIT=main
ARG RHOFOLD_CKPT_SHA256=REPLACE_WITH_VERIFIED_SHA256
# Checkpoint repo on the HF Hub — baked IN FULL below (see the snapshot_download step).
ARG RHOFOLD_CKPT_REPO=cuhkaih/rhofold

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    WORKER_WORK_ROOT=/var/lib/sciable/jobs \
    RHOFOLD_INFERENCE=/opt/rhofold/inference.py \
    RHOFOLD_CHECKPOINT=/opt/rhofold_ckpt/rhofold_pretrained_params.pt \
    RHOFOLD_DEVICE=cuda:0 \
    RHOFOLD_RELAX_STEPS=0 \
    # inference.py calls snapshot_download(local_dir=Path(ckpt).parent)
    # UNCONDITIONALLY (verified against upstream main — no "if exists" guard), so a
    # pre-baked file alone does NOT stop a runtime network hit. Offline mode turns
    # that call into a local no-op against the fully-baked dir below. This is what
    # actually enforces the no-runtime-network / job-isolation rule.
    HF_HUB_OFFLINE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/worker

RUN apt-get update --allow-releaseinfo-change \
    && apt-get install -y --no-install-recommends git wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY worker/requirements-rhofold.txt ./worker/requirements-rhofold.txt
RUN pip install --no-cache-dir -r worker/requirements-rhofold.txt

# Clone upstream at the pinned commit; the runner calls /opt/rhofold/inference.py.
RUN git clone https://github.com/ml4bio/RhoFold /opt/rhofold \
    && git -C /opt/rhofold checkout "${RHOFOLD_COMMIT}" \
    && if [ ! -f /opt/rhofold/inference.py ]; then \
         echo "ERROR: inference.py not found at commit ${RHOFOLD_COMMIT}"; exit 1; \
       fi

# Bake the FULL checkpoint repo (weights + HF offline metadata) into the exact dir
# inference.py downloads into. Using snapshot_download at BUILD time (not a single
# wget) also bakes the .cache/huggingface metadata that offline mode checks, so the
# unconditional runtime snapshot_download resolves locally with no network.
# HF_HUB_OFFLINE=0 here only: the ENV above sets offline mode for RUNTIME, but it
# would also block this build-time download (the 2026-11-07 GHA failure).
RUN HF_HUB_OFFLINE=0 python -c "import os; from huggingface_hub import snapshot_download; \
      snapshot_download(repo_id='${RHOFOLD_CKPT_REPO}', local_dir='/opt/rhofold_ckpt')" \
    && test -f "${RHOFOLD_CHECKPOINT}" \
    && if [ "${RHOFOLD_CKPT_SHA256}" = "REPLACE_WITH_VERIFIED_SHA256" ]; then \
         echo "WARNING: checkpoint sha256 not pinned — skipping verification (dev build)."; \
         sha256sum "${RHOFOLD_CHECKPOINT}"; \
       else \
         echo "${RHOFOLD_CKPT_SHA256}  ${RHOFOLD_CHECKPOINT}" | sha256sum -c -; \
       fi

COPY worker/ /opt/worker/worker/
# Root handler.py is the entrypoint — the form Runpod's GitHub handler detection
# expects (same as the structRFM root Dockerfile). It's method-agnostic (dispatches
# via worker.handler), so it covers rhofold; no separate worker/serverless_entry.py.
COPY handler.py /opt/worker/handler.py

# Non-root; writable per-job root owned by the run user.
# Own the job root; also the checkpoint dir, since offline snapshot_download may
# touch its .cache/huggingface metadata at runtime (worker runs non-root).
RUN useradd --create-home --uid 10001 worker \
    && mkdir -p /var/lib/sciable/jobs \
    && chown -R worker:worker /var/lib/sciable /opt/rhofold_ckpt
USER worker

# Runpod Serverless entrypoint: root handler.py with runpod.serverless.start()
# (the form Runpod's handler detection looks for), matching the structRFM image.
CMD ["python", "-u", "handler.py"]
