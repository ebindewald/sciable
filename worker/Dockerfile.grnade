# gRNAde (inverse RNA design) Runpod Serverless worker image.
#
# Designs candidate RNA sequences for a target 3D backbone (PDB) — inverse folding.
# worker/run_grnade.py imports upstream's src.* programmatic API (featurizer + model),
# baked in here, pointed at the pre-baked checkpoint (GRNADE_CHECKPOINT). Without the
# checkpoint the runner fails loudly (stub only on SCIABLE_ALLOW_STUB=1, CI/dev).
#
# NOT the repo-root Dockerfile (that one is structRFM's). Built by Runpod's console
# GitHub import with Dockerfile Path = /worker/Dockerfile.grnade into Runpod's private
# registry — the only supported deploy path; see docs/ENDPOINT_SETUP.md ("What NOT to do").
#
# Upstream: https://github.com/chaitjo/geometric-rna-design  (MIT code)
# Checkpoint: gRNAde_drop3d@0.75_maxlen@500.h5  (huggingface.co/chaitjo/gRNAde, MIT)
#   ⚠ The HF repo ALSO bundles rhofold/ + ribonanzanet*/ weights under their own
#     LICENSE files; this image bakes ONLY the one gRNAde .h5 (we don't run the
#     RibonanzaNet scoring loop), so those terms don't gate this image. Re-check if
#     you later enable scoring.
#
# Build (GPU hosts are linux/amd64):
#   docker build --platform linux/amd64 -f worker/Dockerfile.grnade \
#     --build-arg GRNADE_COMMIT=<full-sha> \
#     --build-arg GRNADE_CKPT_SHA256=<sha256> \
#     -t <registry>/grnade-worker:<tag> .

# See requirements-grnade.txt: upstream's torch 2.1.0 lacks modern-GPU kernels, so we
# use the same 2.7.1 / CUDA 12.8 base structRFM/rhofold moved to (covers sm_50..sm_120).
# ⚠ torch-2.7 API-compat with gRNAde's GVP layers is unverified — confirm on first smoke run.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

# Verified from GitHub (gRNAde v1.0 release, 2025-12-15) but build-unverified. Ship the
# full sha, never a branch; bump only with a re-verified commit.
ARG GRNADE_COMMIT=2453b18778a1981ac25f314790e5395f1e9ab218
# Checkpoint pinned (verified 2026-11-07): downloaded from HF and sha256summed locally.
# gRNAde_drop3d@0.75_maxlen@500.h5 = 8,726,092 bytes. GRNADE_CKPT_REV pins the HF repo
# revision so a later HF push can't silently change the baked weights.
ARG GRNADE_CKPT_SHA256=d43454deaeec773644bfa52385b6fcc8264db256878fd9ca19ed8711ec62971c
ARG GRNADE_CKPT_REPO=chaitjo/gRNAde
ARG GRNADE_CKPT_REV=91491fc71584bf37fee8297781edf7df07b1d349
ARG GRNADE_CKPT_FILE=gRNAde_drop3d@0.75_maxlen@500.h5

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    WORKER_WORK_ROOT=/var/lib/sciable/jobs \
    GRNADE_REPO=/opt/grnade \
    GRNADE_CHECKPOINT=/opt/grnade_ckpt/gRNAde_drop3d@0.75_maxlen@500.h5 \
    GRNADE_DEVICE=cuda:0 \
    GRNADE_TEMPERATURE=0.1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/worker

RUN apt-get update --allow-releaseinfo-change \
    && apt-get install -y --no-install-recommends git wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY worker/requirements-grnade.txt ./worker/requirements-grnade.txt
RUN pip install --no-cache-dir -r worker/requirements-grnade.txt

# PyG compiled companions, matched to the EXACT torch build in the base image (do NOT
# pin a torch version string by hand — derive it, so a base bump can't silently install
# a mismatched/CPU wheel). The real import chain uses torch_cluster (featurizer) and
# torch_scatter (GVP layers) + torch_geometric; torch_sparse is NOT imported, so it is
# not installed. Verified: data.pyg.org/whl/torch-2.7.1+cu128.html carries pt27cu128
# cp311 wheels for both.
RUN TORCH_VER="$(python -c 'import torch; print(torch.__version__)')" \
    && echo "Installing PyG wheels for torch ${TORCH_VER}" \
    && pip install --no-cache-dir torch_geometric \
    && pip install --no-cache-dir torch_scatter torch_cluster \
         -f "https://data.pyg.org/whl/torch-${TORCH_VER}.html"

# Clone upstream at the pinned commit; the runner imports /opt/grnade/src/*.
RUN git clone https://github.com/chaitjo/geometric-rna-design /opt/grnade \
    && git -C /opt/grnade checkout "${GRNADE_COMMIT}" \
    && test -f /opt/grnade/design.py \
    && test -d /opt/grnade/src

# Bake ONLY the one gRNAde checkpoint (not the bundled third-party weights) into the
# path GRNADE_CHECKPOINT points at. No runtime download: upstream loads it from a local
# path (torch.load), so a baked file is all the runner needs.
RUN python -c "import os; from huggingface_hub import hf_hub_download; \
      p = hf_hub_download(repo_id='${GRNADE_CKPT_REPO}', filename='${GRNADE_CKPT_FILE}', \
          revision='${GRNADE_CKPT_REV}', local_dir='/opt/grnade_ckpt'); \
      print('downloaded', p)" \
    && test -f "${GRNADE_CHECKPOINT}" \
    && if [ "${GRNADE_CKPT_SHA256}" = "REPLACE_WITH_VERIFIED_SHA256" ]; then \
         echo "WARNING: checkpoint sha256 not pinned — skipping verification (dev build)."; \
         sha256sum "${GRNADE_CHECKPOINT}"; \
       else \
         echo "${GRNADE_CKPT_SHA256}  ${GRNADE_CHECKPOINT}" | sha256sum -c -; \
       fi

COPY worker/ /opt/worker/worker/
# Root handler.py is the entrypoint Runpod's GitHub handler detection expects (same as
# the structRFM root / rhofold images). It's method-agnostic (dispatches via
# worker.handler), so it covers grnade; no separate entrypoint.
COPY handler.py /opt/worker/handler.py

# Non-root; own the per-job root and the repo dir (sec_struct_utils may write temp files
# under PROJECT_PATH, which the runner points at the private per-job workspace, but own
# /opt/grnade too in case upstream caches alongside its source).
RUN useradd --create-home --uid 10001 worker \
    && mkdir -p /var/lib/sciable/jobs \
    && chown -R worker:worker /var/lib/sciable /opt/grnade /opt/grnade_ckpt
USER worker

# Runpod Serverless entrypoint: root handler.py with runpod.serverless.start().
CMD ["python", "-u", "handler.py"]
