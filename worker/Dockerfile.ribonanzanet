# RibonanzaNet-SS (RNA base-pairing matrix) Runpod Serverless worker image.
#
# worker/run_ribonanzanet.py imports RibonanzaNetSS from the baked source and reads its
# contact head to return an L×L base-pairing probability matrix. Without the checkpoint the
# runner fails loudly (stub only on SCIABLE_ALLOW_STUB=1, CI/dev).
#
# NOT the repo-root Dockerfile (that's structRFM's). Built by Runpod's console GitHub
# import with Dockerfile Path = /worker/Dockerfile.ribonanzanet into Runpod's private
# registry — the only supported deploy path; see docs/ENDPOINT_SETUP.md ("What NOT to do").
#
# Provenance: canonical RibonanzaNet is https://github.com/Shujun-He/RibonanzaNet (MIT),
# but the SS head is published only as a Kaggle notebook. The fetchable, self-contained
# implementation (network.py + config.yaml) is the gRNAde copy, which credits the original;
# this image clones gRNAde at a pinned commit for that one tools/ directory and bakes the
# ~45 MB checkpoint. Personal/BYOK use, private registry — nothing published publicly.
#
# Build (GPU hosts are linux/amd64):
#   docker build --platform linux/amd64 -f worker/Dockerfile.ribonanzanet \
#     --build-arg GRNADE_COMMIT=<full-sha> \
#     --build-arg RIBONANZANET_CKPT_SHA256=<sha256> \
#     -t <registry>/ribonanzanet-worker:<tag> .

# Upstream's env.yml pins torch 2.1.2/py3.9, but the SS network code has no torch guard
# (plain nn.Module + einsum/einops), so we use the same 2.7.1 / CUDA 12.8 base the other
# methods moved to (covers sm_50..sm_120). ⚠ torch-2.7 compat confirmed only on a smoke run.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

# The gRNAde commit that holds tools/ribonanzanet_sec_struct/{network.py,config.yaml} — the
# fetchable SS implementation. Verified from GitHub (gRNAde v1.0 release); build-unverified.
ARG GRNADE_COMMIT=2453b18778a1981ac25f314790e5395f1e9ab218
# Checkpoint pinned (verified 2026-11-08): downloaded from HF and sha256summed locally.
# ribonanzanet_ss.pt = 45,420,400 bytes. CKPT_REV pins the HF repo revision.
ARG RIBONANZANET_CKPT_SHA256=626060952368affbf61b78b532d6166387094754b68bc0553da376f2d2b00d56
ARG RIBONANZANET_CKPT_REPO=chaitjo/gRNAde
ARG RIBONANZANET_CKPT_REV=91491fc71584bf37fee8297781edf7df07b1d349
ARG RIBONANZANET_CKPT_FILE=ribonanzanet_sec_struct/ribonanzanet_ss.pt

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    WORKER_WORK_ROOT=/var/lib/sciable/jobs \
    RIBONANZANET_REPO=/opt/grnade \
    RIBONANZANET_SS_CHECKPOINT=/opt/ribonanzanet_ckpt/ribonanzanet_sec_struct/ribonanzanet_ss.pt \
    RIBONANZANET_SS_CONFIG=/opt/grnade/tools/ribonanzanet_sec_struct/config.yaml \
    RIBONANZANET_DEVICE=cuda:0 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/worker

RUN apt-get update --allow-releaseinfo-change \
    && apt-get install -y --no-install-recommends git wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY worker/requirements-ribonanzanet.txt ./worker/requirements-ribonanzanet.txt
RUN pip install --no-cache-dir -r worker/requirements-ribonanzanet.txt

# Clone gRNAde at the pinned commit; the runner imports
# tools.ribonanzanet_sec_struct.network (self-contained — no src.* / PyG needed).
RUN git clone https://github.com/chaitjo/geometric-rna-design /opt/grnade \
    && git -C /opt/grnade checkout "${GRNADE_COMMIT}" \
    && test -f /opt/grnade/tools/ribonanzanet_sec_struct/network.py \
    && test -f /opt/grnade/tools/ribonanzanet_sec_struct/config.yaml

# Bake the SS checkpoint (no runtime download — the model torch.loads a local path).
RUN python -c "import os; from huggingface_hub import hf_hub_download; \
      p = hf_hub_download(repo_id='${RIBONANZANET_CKPT_REPO}', filename='${RIBONANZANET_CKPT_FILE}', \
          revision='${RIBONANZANET_CKPT_REV}', local_dir='/opt/ribonanzanet_ckpt'); \
      print('downloaded', p)" \
    && test -f "${RIBONANZANET_SS_CHECKPOINT}" \
    && if [ "${RIBONANZANET_CKPT_SHA256}" = "REPLACE_WITH_VERIFIED_SHA256" ]; then \
         echo "WARNING: checkpoint sha256 not pinned — skipping verification (dev build)."; \
         sha256sum "${RIBONANZANET_SS_CHECKPOINT}"; \
       else \
         echo "${RIBONANZANET_CKPT_SHA256}  ${RIBONANZANET_SS_CHECKPOINT}" | sha256sum -c -; \
       fi

COPY worker/ /opt/worker/worker/
# Root handler.py is the entrypoint Runpod's GitHub handler detection expects (same as the
# other images). It's method-agnostic (dispatches via worker.handler), so it covers
# ribonanzanet; no separate entrypoint.
COPY handler.py /opt/worker/handler.py

# Non-root; own the per-job root and the baked source/checkpoint dirs.
RUN useradd --create-home --uid 10001 worker \
    && mkdir -p /var/lib/sciable/jobs \
    && chown -R worker:worker /var/lib/sciable /opt/grnade /opt/ribonanzanet_ckpt
USER worker

# Runpod Serverless entrypoint: root handler.py with runpod.serverless.start().
CMD ["python", "-u", "handler.py"]
